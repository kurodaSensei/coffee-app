rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticatedCreate() {
      return request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    function isFriendshipParticipant() {
      return request.auth != null
        && request.auth.uid in resource.data.uids;
    }

    // User-owned collections
    match /roasters/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticatedCreate();
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Shareable collections: allow read if owner OR if included in sharedWith
    match /coffees/{docId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || request.auth.uid in resource.data.sharedWith);
      allow create: if isAuthenticatedCreate();
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /tastings/{docId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || request.auth.uid in resource.data.sharedWith);
      allow create: if isAuthenticatedCreate();
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /recipes/{docId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || request.auth.uid in resource.data.sharedWith);
      allow create: if isAuthenticatedCreate();
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /wishlist/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticatedCreate();
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // User preferences: doc id equals user uid
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users directory: anyone authenticated can look up, only owner writes
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Waitlist: anyone can create (public landing form), but nobody can read/update/delete.
    // Doc id is the normalized email, so re-submitting the same email naturally fails
    // the create rule (because the doc already exists) → client treats as duplicate.
    match /waitlist/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email == email
        && request.resource.data.email.size() < 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.source is string
        && request.resource.data.source.size() < 50;
      allow read, update, delete: if false;
    }

    // Friendships: both participants can read, either can write if they are participants
    match /friendships/{friendshipId} {
      allow read: if isFriendshipParticipant();
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.status == 'pending'
        && request.resource.data.initiatedBy == request.auth.uid;
      allow update: if isFriendshipParticipant();
      allow delete: if isFriendshipParticipant();
    }
  }
}
